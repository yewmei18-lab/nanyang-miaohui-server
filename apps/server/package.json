{
  "name": "@nanyang/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:db": "tsx --test --test-concurrency=1 test/ledger.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e.test.ts",
    "test:load": "tsx test/load.ts 18 10"
  },
  "dependencies": {
    "@colyseus/core": "0.18.12",
    "@colyseus/schema": "5.0.48",
    "@colyseus/ws-transport": "0.18.5",
    "@nanyang/shared": "*",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
